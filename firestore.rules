rules_version = '2';

// Regras do Firestore — Checklist Financeiro (Totali Soluções Contábeis)
//
// Modelo de acesso:
//  - O cliente preenche o formulário sem cadastro. Ele é autenticado de forma
//    anônima só para o envio, e por isso consegue CRIAR, mas nunca ler nem alterar.
//  - A equipe da Totali só enxerga se o usuário existir em /usuarios/{uid}.
//    Ter conta no Firebase não basta: alguém precisa cadastrar a pessoa ali.
//  - Login e senha das maquinetas ficam numa subcoleção separada, visível
//    apenas para quem tem papel "admin".
//
// Cole este conteúdo em: Firestore Database > Regras > Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    function ehEquipe() {
      return request.auth != null
             && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function ehAdmin() {
      return ehEquipe()
             && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin';
    }

    match /checklists/{id} {

      // Envio do formulário. Anônimo serve, mas tem de estar autenticado —
      // isso impede envio por script sem passar pelo app.
      allow create: if request.auth != null
                    && request.resource.data.status == 'novo'
                    && request.resource.data.protocolo is string
                    && request.resource.data.empresa.nome is string
                    && request.resource.data.empresa.nome.size() > 2
                    && request.resource.data.empresa.cnpj is string
                    && request.resource.data.keys().hasAll(
                         ['protocolo','status','empresa','bancos','maquinetas','formaDocumentos'])
                    && (request.resource.data.termo == null
                        || request.resource.data.termo.nome is string);

      allow read: if ehEquipe();

      // A equipe só mexe no acompanhamento, nunca no que o cliente respondeu.
      allow update: if ehEquipe()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status','anotacaoInterna','atualizadoEm']);

      allow delete: if ehAdmin();

      // Credenciais das maquinetas — o dado mais sensível do sistema.
      match /acessos/{maquineta} {
        allow create: if request.auth != null;
        allow read:   if ehAdmin();
        allow update, delete: if ehAdmin();
      }

      // O termo de compromisso em PDF, guardado em base64. Uma vez gravado, o
      // conteúdo é imutável — é um documento com valor probatório. O admin pode
      // apagar, mas só ao excluir a empresa inteira; nunca alterar o texto.
      match /termo/{arquivo} {
        allow create: if request.auth != null
                      && request.resource.data.base64 is string;
        allow read:   if ehEquipe();
        allow update: if false;
        allow delete: if ehAdmin();
      }
    }

    // Quem pode entrar no painel. Um admin gerencia isso pelo próprio painel.
    match /usuarios/{uid} {

      // Cada pessoa lê o próprio cadastro (é o que o painel checa no login);
      // o admin lê todos, para montar a lista de acessos.
      allow read: if request.auth != null && (request.auth.uid == uid || ehAdmin());

      allow create: if ehAdmin()
                    && request.resource.data.papel in ['admin', 'equipe']
                    && request.resource.data.nome is string
                    && request.resource.data.email is string;

      allow update: if ehAdmin()
                    && request.resource.data.papel in ['admin', 'equipe'];

      // Ninguém remove o próprio acesso: evita o projeto ficar sem administrador.
      allow delete: if ehAdmin() && request.auth.uid != uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
